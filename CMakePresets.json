{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug Build",
      "description": "Debug build with sanitizers enabled",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CONSISTENT_HASH_ENABLE_SANITIZERS": "ON",
        "CONSISTENT_HASH_BUILD_TESTS": "ON",
        "CONSISTENT_HASH_BUILD_BENCHMARKS": "OFF",
        "CONSISTENT_HASH_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release Build",
      "description": "Optimized release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CONSISTENT_HASH_ENABLE_SANITIZERS": "OFF",
        "CONSISTENT_HASH_BUILD_TESTS": "ON",
        "CONSISTENT_HASH_BUILD_BENCHMARKS": "ON",
        "CONSISTENT_HASH_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "ci",
      "inherits": "release",
      "displayName": "CI Build",
      "description": "Build configuration for CI pipelines",
      "cacheVariables": {
        "CONSISTENT_HASH_BUILD_TESTS": "ON",
        "CONSISTENT_HASH_BUILD_BENCHMARKS": "ON",
        "CONSISTENT_HASH_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Coverage Build",
      "description": "Debug build with code coverage instrumentation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CONSISTENT_HASH_ENABLE_COVERAGE": "ON",
        "CONSISTENT_HASH_BUILD_TESTS": "ON",
        "CONSISTENT_HASH_BUILD_BENCHMARKS": "OFF",
        "CONSISTENT_HASH_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "Fuzzer Build",
      "description": "Release build with libFuzzer (requires Clang)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CONSISTENT_HASH_BUILD_FUZZERS": "ON",
        "CONSISTENT_HASH_BUILD_TESTS": "OFF",
        "CONSISTENT_HASH_BUILD_BENCHMARKS": "OFF",
        "CONSISTENT_HASH_BUILD_EXAMPLES": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {"outputOnFailure": true}
    }
  ]
}